Процедура Проверить(Условие, Текст)
    Если Не Условие Тогда ВызватьИсключение Текст; КонецЕсли;
КонецПроцедуры

Функция Элемент(Вид, Имя)
    Если Вид = "Товар" Тогда О = Справочники.Товары.СоздатьЭлемент(); О.Артикул = "USB-01"; О.ЕдиницаИзмерения = "шт.";
    ИначеЕсли Вид = "Клиент" Тогда О = Справочники.Клиенты.СоздатьЭлемент(); Иначе О = Справочники.Склады.СоздатьЭлемент(); КонецЕсли;
    О.Наименование = Имя; О.Записать(); Возврат О.Ссылка;
КонецФункции

Процедура СтрокаДокумента(О, К, Склад, Количество, Цена = 100)
    С = О.Товары.Добавить(); С.Товар = К.Товар; С.Склад = Склад; С.Количество = Количество;
    Если О.Метаданные().Имя = "ЗаказКлиента" Тогда С.Цена = Цена; КонецЕсли;
КонецПроцедуры

Функция Документ(Вид, К, А, Б, Провести = Истина)
    Если Вид = "Приход" Тогда О = Документы.ПоступлениеТоваров.СоздатьДокумент();
    ИначеЕсли Вид = "Заказ" Тогда О = Документы.ЗаказКлиента.СоздатьДокумент(); О.Клиент = К.Клиент;
    Иначе О = Документы.ОтгрузкаТоваров.СоздатьДокумент(); О.ЗаказКлиента = К.Заказ.Ссылка; КонецЕсли;
    О.Дата = ТекущаяДата();
    Если А <> 0 Тогда СтрокаДокумента(О, К, К.А, А); КонецЕсли;
    Если Б <> 0 Тогда СтрокаДокумента(О, К, К.Б, Б); КонецЕсли;
    О.Записать(?(Провести, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись)); Возврат О;
КонецФункции

Функция Контекст(Уровень, Метка = "")
    Суффикс = ?(Метка = "", "", " (" + Метка + ")");
    К = Новый Структура("Товар,Клиент,А,Б,Приход,Заказ,Отгрузка1,Отгрузка2");
    К.Товар = Элемент("Товар", "Кабель USB" + Суффикс); К.Клиент = Элемент("Клиент", "Учебный клиент" + Суффикс);
    К.А = Элемент("Склад", "Склад А" + Суффикс); К.Б = Элемент("Склад", "Склад Б" + Суффикс);
    Если Уровень >= 1 Тогда К.Приход = Документ("Приход", К, 10, 8); КонецЕсли;
    Если Уровень >= 2 Тогда К.Заказ = Документ("Заказ", К, 6, 5); КонецЕсли;
    Если Уровень >= 3 Тогда К.Отгрузка1 = Документ("Отгрузка", К, 2, 3); КонецЕсли;
    Если Уровень >= 4 Тогда К.Отгрузка2 = Документ("Отгрузка", К, 4, 2); КонецЕсли;
    Возврат К;
КонецФункции

Процедура Пара(К, Склад, Q, R)
    Строки = СкладскойУчет.Остатки().НайтиСтроки(Новый Структура("Товар,Склад", К.Товар, Склад)); ФактQ = 0; ФактR = 0;
    Если Строки.Количество() > 0 Тогда ФактQ = Строки[0].Физический; ФактR = Строки[0].Резерв; КонецЕсли;
    Проверить(ФактQ = Q И ФактR = R, "Остаток " + Строка(Склад) + ": " + Строка(ФактQ) + "/" + Строка(ФактR) + ", ожидалось " + Строка(Q) + "/" + Строка(R));
КонецПроцедуры

Процедура ПроверитьСостояние(К, QA, RA, QБ, RБ)
    Пара(К, К.А, QA, RA); Пара(К, К.Б, QБ, RБ);
КонецПроцедуры

Функция Снимок()
    Результат = "";
    Для Каждого Имя Из СтрРазделить("ПоступлениеТоваров,ЗаказКлиента,ОтгрузкаТоваров", ",") Цикл
        Поля = "Ссылка,Номер,Дата,Проведен,ПометкаУдаления,Комментарий";
        Если Имя = "ЗаказКлиента" Тогда Поля = Поля + ",Клиент"; ИначеЕсли Имя = "ОтгрузкаТоваров" Тогда Поля = Поля + ",ЗаказКлиента"; КонецЕсли;
        Результат = Результат + ЗначениеВСтрокуВнутр(СкладскойУчет.ЗапросТаблица("ВЫБРАТЬ " + Поля + " ИЗ Документ." + Имя + " УПОРЯДОЧИТЬ ПО Ссылка"));
        Поля = "Ссылка,НомерСтроки,Товар,Склад,Количество";
        Если Имя = "ЗаказКлиента" Тогда Поля = Поля + ",Цена,Сумма"; КонецЕсли;
        Результат = Результат + ЗначениеВСтрокуВнутр(СкладскойУчет.ЗапросТаблица("ВЫБРАТЬ " + Поля + " ИЗ Документ." + Имя + ".Товары УПОРЯДОЧИТЬ ПО Ссылка,НомерСтроки"));
    КонецЦикла;
    Для Каждого Имя Из СтрРазделить("ОстаткиТоваров,РезервыТоваров", ",") Цикл
        Поля = "Регистратор,НомерСтроки,Активность,Период,ВидДвижения,Товар,Склад,Количество";
        Если Имя = "РезервыТоваров" Тогда Поля = Поля + ",ЗаказКлиента"; КонецЕсли;
        Результат = Результат + ЗначениеВСтрокуВнутр(СкладскойУчет.ЗапросТаблица("ВЫБРАТЬ " + Поля + " ИЗ РегистрНакопления." + Имя + " УПОРЯДОЧИТЬ ПО Регистратор,НомерСтроки"));
    КонецЦикла;
    Возврат Результат;
КонецФункции

Процедура ОтказЗаписи(О, Режим, Код = "", Удалить = Ложь)
    До = Снимок(); БылОтказ = Ложь;
    Попытка
        Если Удалить Тогда О.Удалить(); Иначе О.Записать(Режим); КонецЕсли;
    Исключение
        БылОтказ = Истина;
        Если Код <> "" Тогда Проверить(СтрНайти(ОписаниеОшибки(), Код) > 0, "Неожиданный отказ: " + ОписаниеОшибки()); КонецЕсли;
    КонецПопытки;
    Проверить(БылОтказ, "Операция должна быть отклонена."); Проверить(До = Снимок(), "При отказе изменились документы или движения.");
КонецПроцедуры

Процедура ПроверкиНачала(Н)
    Если Н = 1 Тогда
        О = Справочники.Товары.СоздатьЭлемент(); БылОтказ = Ложь;
        Попытка О.Записать(); Исключение БылОтказ = Истина; КонецПопытки; Проверить(БылОтказ, "Пустое наименование не отклонено.");
        К = Контекст(0, "TC-01"); Проверить(К.Товар.ПолучитьОбъект().Артикул = "USB-01" И К.Клиент.ПолучитьОбъект().Наименование <> "" И К.А <> К.Б, "Повторное чтение справочников.");
    ИначеЕсли Н = 2 Тогда К = Контекст(1, "TC-02"); ПроверитьСостояние(К, 10, 0, 8, 0);
    ИначеЕсли Н = 3 Тогда
        К = Контекст(1, "TC-03"); О = Документ("Заказ", К, 6, 5, Ложь); О = О.Ссылка.ПолучитьОбъект();
        Проверить(О.Товары[0].Сумма = 600 И О.Товары[1].Сумма = 500, "Неверная сумма."); ПроверитьСостояние(К, 10, 0, 8, 0);
    ИначеЕсли Н = 4 Тогда К = Контекст(2, "TC-04"); ПроверитьСостояние(К, 10, 6, 8, 5);
    ИначеЕсли Н = 5 Тогда
        К = Контекст(2, "TC-05"); О = Документ("Заказ", К, 1, 4, Ложь); ОтказЗаписи(О, РежимЗаписиДокумента.Проведение, "INSUFFICIENT_STOCK");
        О = Документ("Заказ", К, 5, 0, Ложь); ОтказЗаписи(О, РежимЗаписиДокумента.Проведение, "INSUFFICIENT_STOCK"); ПроверитьСостояние(К, 10, 6, 8, 5);
    Иначе
        К = Контекст(1, "TC-06"); О = Документ("Заказ", К, 1, 0, Ложь); СтрокаДокумента(О, К, К.А, 2); ОтказЗаписи(О, РежимЗаписиДокумента.Запись, "VALIDATION");
        О = Документ("Заказ", К, 1, 1); ПроверитьСостояние(К, 10, 1, 8, 1);
    КонецЕсли;
КонецПроцедуры

Процедура ПроверкиОтгрузки(Н)
    Если Н = 7 Тогда К = Контекст(3, "TC-07"); ПроверитьСостояние(К, 8, 4, 5, 2);
    ИначеЕсли Н = 8 Тогда
        К = Контекст(4, "TC-08"); ПроверитьСостояние(К, 4, 0, 3, 0); К.Отгрузка2.Записать(РежимЗаписиДокумента.ОтменаПроведения); ПроверитьСостояние(К, 8, 4, 5, 2);
    ИначеЕсли Н = 9 Тогда
        К = Контекст(3, "TC-09"); О = Документ("Отгрузка", К, 5, 0, Ложь); ОтказЗаписи(О, РежимЗаписиДокумента.Проведение, "INSUFFICIENT_STOCK");
        О = Документ("Отгрузка", К, 1, 3, Ложь); ОтказЗаписи(О, РежимЗаписиДокумента.Проведение, "INSUFFICIENT_STOCK"); ПроверитьСостояние(К, 8, 4, 5, 2);
    ИначеЕсли Н = 10 Тогда
        К = Контекст(2, "TC-10"); К.Заказ = Документ("Заказ", К, 3, 0); К.Заказ.Клиент = Элемент("Клиент", "Второй учебный клиент"); К.Заказ.Записать(РежимЗаписиДокумента.Проведение);
        О = Документ("Отгрузка", К, 4, 0, Ложь); ОтказЗаписи(О, РежимЗаписиДокумента.Проведение, "INSUFFICIENT_STOCK");
        О = Документ("Отгрузка", К, 0, 1, Ложь); ОтказЗаписи(О, РежимЗаписиДокумента.Проведение, "VALIDATION"); ПроверитьСостояние(К, 10, 9, 8, 5);
    Иначе
        К = Контекст(3, "TC-11a"); К.Приход.Записать(РежимЗаписиДокумента.Проведение); К.Заказ.Записать(РежимЗаписиДокумента.Проведение); К.Отгрузка1.Записать(РежимЗаписиДокумента.Проведение); ПроверитьСостояние(К, 8, 4, 5, 2);
        К.Отгрузка1.Товары[0].Количество = 1; К.Отгрузка1.Записать(РежимЗаписиДокумента.Проведение); ПроверитьСостояние(К, 9, 5, 5, 2);
        К = Контекст(2, "TC-11b"); К.Заказ.Товары[0].Количество = 5; К.Заказ.Товары[1].Количество = 4; К.Заказ.Записать(РежимЗаписиДокумента.Проведение); ПроверитьСостояние(К, 10, 5, 8, 4);
        К.Заказ.Товары.Удалить(1); К.Заказ.Записать(РежимЗаписиДокумента.Проведение); ПроверитьСостояние(К, 10, 5, 8, 0);
        К.Заказ.Товары[0].Склад = К.Б; К.Заказ.Записать(РежимЗаписиДокумента.Проведение); ПроверитьСостояние(К, 10, 0, 8, 5);
    КонецЕсли;
КонецПроцедуры

Процедура ПроверкиЗащиты(Н)
    Если Н = 12 Тогда
        К = Контекст(1, "TC-12"); О = Документ("Заказ", К, 0, 0, Ложь); ОтказЗаписи(О, РежимЗаписиДокумента.Проведение, "VALIDATION");
        СтрокаДокумента(О, К, К.А, 1); О.Товары[0].Товар = Справочники.Товары.ПустаяСсылка(); ОтказЗаписи(О, РежимЗаписиДокумента.Проведение, "VALIDATION");
        О.Товары[0].Товар = К.Товар; О.Товары[0].Количество = 0; ОтказЗаписи(О, РежимЗаписиДокумента.Проведение, "VALIDATION");
        О.Товары[0].Количество = -1; ОтказЗаписи(О, РежимЗаписиДокумента.Запись, "VALIDATION");
        О.Товары[0].Количество = 0.125; О.Товары[0].Цена = -1; ОтказЗаписи(О, РежимЗаписиДокумента.Запись, "VALIDATION");
        О.Товары[0].Цена = 0; О.Записать(РежимЗаписиДокумента.Проведение); ПроверитьСостояние(К, 10, 0.125, 8, 0); Проверить(О.Ссылка.ПолучитьОбъект().Товары[0].Сумма = 0, "Нулевая цена.");
        Т = К.Товар.ПолучитьОбъект(); Т.ЕдиницаИзмерения = "кг"; Отказ = Ложь; Попытка Т.Записать(); Исключение Отказ = Истина; КонецПопытки;
        Проверить(Отказ И К.Товар.ПолучитьОбъект().ЕдиницаИзмерения = "шт.", "Изменена единица с движениями.");
    ИначеЕсли Н = 13 Тогда
        К = Контекст(3, "TC-13"); О = Документ("Отгрузка", К, 3, 0, Ложь); СтрокаДокумента(О, К, К.А, 2); ОтказЗаписи(О, РежимЗаписиДокумента.Проведение, "INSUFFICIENT_STOCK"); ПроверитьСостояние(К, 8, 4, 5, 2);
        О = Документ("Приход", К, 1, 0, Ложь); СтрокаДокумента(О, К, К.А, 2); О.Записать(РежимЗаписиДокумента.Проведение); ПроверитьСостояние(К, 11, 4, 5, 2);
    ИначеЕсли Н = 14 Тогда
        К = Контекст(3, "TC-14"); К.Заказ.Товары[0].Количество = 5; ОтказЗаписи(К.Заказ, РежимЗаписиДокумента.Проведение, "DEPENDENCY_EXISTS");
        К.Заказ = К.Заказ.Ссылка.ПолучитьОбъект(); ОтказЗаписи(К.Заказ, РежимЗаписиДокумента.ОтменаПроведения, "DEPENDENCY_EXISTS"); К.Заказ = К.Заказ.Ссылка.ПолучитьОбъект(); ОтказЗаписи(К.Заказ, РежимЗаписиДокумента.Запись, "DEPENDENCY_EXISTS", Истина);
        Черновик = Документ("Отгрузка", К, 1, 0, Ложь); К.Отгрузка1.Записать(РежимЗаписиДокумента.ОтменаПроведения); ПроверитьСостояние(К, 10, 6, 8, 5);
        К.Заказ.Записать(РежимЗаписиДокумента.ОтменаПроведения); ПроверитьСостояние(К, 10, 0, 8, 0); ОтказЗаписи(Черновик, РежимЗаписиДокумента.Проведение, "VALIDATION");
    Иначе
        К = Контекст(2, "TC-15a"); ОтказЗаписи(К.Приход, РежимЗаписиДокумента.ОтменаПроведения, "DEPENDENCY_EXISTS");
        К.Приход = К.Приход.Ссылка.ПолучитьОбъект(); К.Приход.Товары[0].Количество = 5; ОтказЗаписи(К.Приход, РежимЗаписиДокумента.Проведение, "DEPENDENCY_EXISTS"); ПроверитьСостояние(К, 10, 6, 8, 5);
        К = Контекст(1, "TC-15b"); К.Приход.Записать(РежимЗаписиДокумента.ОтменаПроведения); ПроверитьСостояние(К, 0, 0, 0, 0);
    КонецЕсли;
КонецПроцедуры

Процедура ПроверкиОтчетов(Н)
    Если Н = 16 Тогда
        Для Уровень = 0 По 4 Цикл
            К = Контекст(Уровень, "TC-16-" + Строка(Уровень)); П = Новый Структура("productId,warehouseId", НРег(Строка(К.Товар.УникальныйИдентификатор())), НРег(Строка(К.А.УникальныйИдентификатор())));
            Отчет = ВебСервисСклад.ОтчетОстатков(П);
            Если Уровень = 0 Тогда Проверить(Отчет.rows.Количество() = 0, "S0 не пуст.");
            Иначе
                Проверить(Отчет.rows.Количество() = 1, "Отбор остатков."); Q = ?(Уровень <= 2, 10, ?(Уровень = 3, 8, 4)); R = ?(Уровень = 1 Или Уровень = 4, 0, ?(Уровень = 2, 6, 4));
                Проверить(XMLЗначение(Тип("Число"), Отчет.rows[0].physical) = Q И XMLЗначение(Тип("Число"), Отчет.rows[0].reserved) = R, "Отчёт S" + Строка(Уровень));
            КонецЕсли;
        КонецЦикла;
        К = Контекст(2, "TC-16-multi"); Доп = Документ("Заказ", К, 3, 0); П = Новый Структура("productId,warehouseId", НРег(Строка(К.Товар.УникальныйИдентификатор())), НРег(Строка(К.А.УникальныйИдентификатор())));
        О = ВебСервисСклад.ОтчетОстатков(П); Проверить(XMLЗначение(Тип("Число"), О.rows[0].physical) = 10 И XMLЗначение(Тип("Число"), О.rows[0].reserved) = 9, "Размножение строк отчёта.");
    ИначеЕсли Н = 17 Тогда
        Для Уровень = 1 По 4 Цикл
            К = Контекст(Уровень, "TC-17-" + Строка(Уровень)); Если Уровень = 1 Тогда К.Заказ = Документ("Заказ", К, 6, 5, Ложь); КонецЕсли;
            П = Новый Структура("clientId,orderId", НРег(Строка(К.Клиент.УникальныйИдентификатор())), НРег(Строка(К.Заказ.Ссылка.УникальныйИдентификатор())));
            О = ВебСервисСклад.ОтчетЗаказов(П); Ожидается = ?(Уровень = 1, "Черновик", ?(Уровень = 2, "Зарезервирован", ?(Уровень = 3, "Частично отгружен", "Отгружен")));
            Проверить(О.rows.Количество() = 2 И О.rows[0].state = Ожидается, "Отбор или состояние заказа.");
            Если Уровень = 1 Тогда Проверить(XMLЗначение(Тип("Число"), О.rows[0].remaining) = 0, "Черновик показан как резерв."); КонецЕсли;
        КонецЦикла;
    Иначе
        К = Контекст(4, "TC-18"); ПроверитьСостояние(К, 4, 0, 3, 0); ТД = Новый ТабличныйДокумент;
        ВебСервисСклад.ВывестиОтчет("stock", ТД); Проверить(ТД.ВысотаТаблицы > 1, "Нет табличного отчёта остатков.");
        ВебСервисСклад.ВывестиОтчет("orders", ТД); Проверить(ТД.ВысотаТаблицы > 1, "Нет табличного отчёта заказов.");
    КонецЕсли;
КонецПроцедуры

Процедура ЗапуститьПроверки(ПутьРезультата) Экспорт
    Результаты = Новый Массив; ВсеПройдены = Истина;
    Для Н = 1 По 18 Цикл
        Попытка
            Если Н <= 6 Тогда ПроверкиНачала(Н); ИначеЕсли Н <= 11 Тогда ПроверкиОтгрузки(Н); ИначеЕсли Н <= 15 Тогда ПроверкиЗащиты(Н); Иначе ПроверкиОтчетов(Н); КонецЕсли;
            Результаты.Добавить(Новый Структура("id,passed", "TC-" + Прав("0" + Строка(Н), 2), Истина));
        Исключение
            ВсеПройдены = Ложь; Результаты.Добавить(Новый Структура("id,passed,error", "TC-" + Прав("0" + Строка(Н), 2), Ложь, ОписаниеОшибки()));
        КонецПопытки;
    КонецЦикла;
    Информация = Новый СистемнаяИнформация;
    Итог = Новый Структура("passed,platform,cases", ВсеПройдены, Информация.ВерсияПриложения, Результаты);
    Т = Новый ЗаписьТекста(ПутьРезультата, КодировкаТекста.UTF8); Т.Записать(СкладскойУчет.JSONСтрока(Итог)); Т.Закрыть();
КонецПроцедуры

Процедура ПодготовитьДемонстрацию(ПутьРезультата) Экспорт
    К = Контекст(4); ПроверитьСостояние(К, 4, 0, 3, 0);
    Результат = Новый Структура("orderId,productId", НРег(Строка(К.Заказ.Ссылка.УникальныйИдентификатор())), НРег(Строка(К.Товар.УникальныйИдентификатор())));
    Т = Новый ЗаписьТекста(ПутьРезультата, КодировкаТекста.UTF8); Т.Записать(СкладскойУчет.JSONСтрока(Результат)); Т.Закрыть();
КонецПроцедуры

Процедура ПроверитьПовторAPI(ПутьРезультата) Экспорт
    Пройдено = Ложь; ОшибкаПроверки = "";
    Попытка
        Команда = Новый Структура("id,operation,payload", НРег(Строка(Новый УникальныйИдентификатор)), "catalog.save", Новый Структура("entity,data", "clients", Новый Структура("name", "Проверка UUID")));
        Задание = Новый Структура("id,attempt,fingerprint,command", Команда.id, НРег(Строка(Новый УникальныйИдентификатор)), "первый отпечаток", Команда);
        Ответ1 = ВебСервисСклад.ИзJSON(ВебСервисСклад.ОбработатьЗадание(СкладскойУчет.JSONСтрока(Задание)));
        Проверить(Ответ1.status = "succeeded", "Первая запись: " + СкладскойУчет.JSONСтрока(Ответ1));
        Задание.attempt = НРег(Строка(Новый УникальныйИдентификатор));
        Ответ2 = ВебСервисСклад.ИзJSON(ВебСервисСклад.ОбработатьЗадание(СкладскойУчет.JSONСтрока(Задание)));
        Проверить(Ответ2.status = "succeeded" И Ответ1.result.item.id = Ответ2.result.item.id, "Повтор UUID создал другой объект.");
        Задание.fingerprint = "другой отпечаток"; Команда.payload.data.name = "Другое содержимое";
        Ответ3 = ВебСервисСклад.ИзJSON(ВебСервисСклад.ОбработатьЗадание(СкладскойУчет.JSONСтрока(Задание)));
        Проверить(Ответ3.status = "failed" И Ответ3.error.code = "UUID_CONFLICT", "Подмена содержимого UUID не отклонена.");
        Пройдено = Истина;
    Исключение ОшибкаПроверки = ОписаниеОшибки(); КонецПопытки;
    Итог = Новый Структура("passed,error", Пройдено, ОшибкаПроверки);
    Т = Новый ЗаписьТекста(ПутьРезультата, КодировкаТекста.UTF8); Т.Записать(СкладскойУчет.JSONСтрока(Итог)); Т.Закрыть();
КонецПроцедуры

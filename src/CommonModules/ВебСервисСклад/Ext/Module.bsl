Функция ИзJSON(Текст) Экспорт
    Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(Текст);
    Результат = ПрочитатьJSON(Чтение); Чтение.Закрыть(); Возврат Результат;
КонецФункции

Функция Поле(Данные, Имя, ПоУмолчанию = "")
    Значение = Неопределено;
    Если Данные.Свойство(Имя, Значение) Тогда Возврат Значение; КонецЕсли;
    Возврат ПоУмолчанию;
КонецФункции

Функция Менеджер(Вид)
    Если Вид = "products" Тогда Возврат Справочники.Товары;
    ИначеЕсли Вид = "clients" Тогда Возврат Справочники.Клиенты;
    ИначеЕсли Вид = "warehouses" Тогда Возврат Справочники.Склады;
    ИначеЕсли Вид = "orders" Тогда Возврат Документы.ЗаказКлиента;
    ИначеЕсли Вид = "receipts" Тогда Возврат Документы.ПоступлениеТоваров;
    ИначеЕсли Вид = "shipments" Тогда Возврат Документы.ОтгрузкаТоваров;
    КонецЕсли;
    СкладскойУчет.Ошибка("VALIDATION", "Неизвестный вид объекта.");
КонецФункции

Функция ЭтоСправочник(Вид)
    Возврат Вид = "products" Или Вид = "clients" Или Вид = "warehouses";
КонецФункции

Функция ПоляСправочника(Вид)
    Если Вид = "products" Тогда Возврат Новый Структура("name,sku,unit", "Наименование", "Артикул", "ЕдиницаИзмерения");
    ИначеЕсли Вид = "clients" Тогда Возврат Новый Структура("name,phone,email,comment", "Наименование", "Телефон", "ЭлектроннаяПочта", "Комментарий");
    Иначе Возврат Новый Структура("name,description", "Наименование", "Описание"); КонецЕсли;
КонецФункции

Функция ИД(Ссылка)
    Возврат ?(ЗначениеЗаполнено(Ссылка), НРег(Строка(Ссылка.УникальныйИдентификатор())), "");
КонецФункции

Функция Ссылка(Вид, Идентификатор)
    Если ПустаяСтрока(Идентификатор) Тогда Возврат Менеджер(Вид).ПустаяСсылка(); КонецЕсли;
    Ссылка = Менеджер(Вид).ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
    Если Ссылка.ПолучитьОбъект() = Неопределено Тогда СкладскойУчет.Ошибка("NOT_FOUND", "Объект по указанной ссылке не найден."); КонецЕсли;
    Возврат Ссылка;
КонецФункции

Функция Десятичное(Число, Точность = 3) Экспорт
    Возврат Формат(Число, "ЧГ=0;ЧДЦ=" + Строка(Точность) + ";ЧРД=.;ЧН=0");
КонецФункции

Функция ОстаткиЗаказа(Заказ)
    Возврат СкладскойУчет.ЗапросТаблица("ВЫБРАТЬ Товар, Склад, КоличествоОстаток КАК Осталось
    | ИЗ РегистрНакопления.РезервыТоваров.Остатки(, ЗаказКлиента = &Заказ)", Новый Структура("Заказ", Заказ));
КонецФункции

Функция Исполнение(Объект) Экспорт
    Остатки = ОстаткиЗаказа(Объект.Ссылка); Строки = Новый Массив;
    ЕстьОтгрузка = Ложь; ЕстьОстаток = Ложь;
    Для Каждого С Из Объект.Товары Цикл
        Осталось = 0;
        Найденные = Остатки.НайтиСтроки(Новый Структура("Товар,Склад", С.Товар, С.Склад));
        Если Найденные.Количество() > 0 Тогда Осталось = Найденные[0].Осталось; КонецЕсли;
        Отгружено = ?(Объект.Проведен, С.Количество - Осталось, 0);
        ЕстьОтгрузка = ЕстьОтгрузка Или Отгружено > 0; ЕстьОстаток = ЕстьОстаток Или Осталось > 0;
        Д = Новый Структура("productId,productName,warehouseId,warehouseName,ordered,shipped,remaining", ИД(С.Товар), Строка(С.Товар), ИД(С.Склад), Строка(С.Склад), Десятичное(С.Количество), Десятичное(Отгружено), Десятичное(Осталось));
        Строки.Добавить(Д);
    КонецЦикла;
    Состояние = "Черновик";
    Если Объект.Проведен Тогда
        Состояние = ?(Не ЕстьОстаток, "Отгружен", ?(ЕстьОтгрузка, "Частично отгружен", "Зарезервирован"));
    КонецЕсли;
    Возврат Новый Структура("rows,state", Строки, Состояние);
КонецФункции

Функция ДанныеОбъекта(Объект, Вид) Экспорт
    Данные = Новый Структура("id,deleted", ИД(Объект.Ссылка), Объект.ПометкаУдаления);
    Если ЭтоСправочник(Вид) Тогда
        Для Каждого П Из ПоляСправочника(Вид) Цикл Данные.Вставить(П.Ключ, Объект[П.Значение]); КонецЦикла;
    Иначе
        Данные.Вставить("number", Объект.Номер);
        Данные.Вставить("date", ЗаписатьДатуJSON(УниверсальноеВремя(Объект.Дата, "Europe/Moscow"), ФорматДатыJSON.ISO));
        Данные.Вставить("posted", Объект.Проведен); Данные.Вставить("comment", Объект.Комментарий);
        Если Вид = "orders" Тогда Данные.Вставить("clientId", ИД(Объект.Клиент)); КонецЕсли;
        Если Вид = "shipments" Тогда Данные.Вставить("orderId", ИД(Объект.ЗаказКлиента)); КонецЕсли;
        Строки = Новый Массив; Сумма = 0;
        Для Каждого С Из Объект.Товары Цикл
            СтрокаДанных = Новый Структура("productId,warehouseId,quantity", ИД(С.Товар), ИД(С.Склад), Десятичное(С.Количество));
            Если Вид = "orders" Тогда
                СтрокаДанных.Вставить("price", Десятичное(С.Цена, 2)); СтрокаДанных.Вставить("amount", Десятичное(С.Сумма, 2)); Сумма = Сумма + С.Сумма;
            КонецЕсли;
            Строки.Добавить(СтрокаДанных);
        КонецЦикла;
        Данные.Вставить("rows", Строки);
        Если Вид = "orders" Тогда Данные.Вставить("total", Десятичное(Сумма, 2)); КонецЕсли;
    КонецЕсли;
    // Версия по собственным сохраняемым данным, без представлений связанных справочников.
    Хеш = Новый ХешированиеДанных(ХешФункция.SHA256); Хеш.Добавить(СкладскойУчет.JSONСтрока(Данные));
    Данные.Вставить("version", Base64Строка(Хеш.ХешСумма));
    Если Вид = "orders" Тогда
        Данные.Вставить("clientName", Строка(Объект.Клиент)); Данные.Вставить("state", Исполнение(Объект).state);
    ИначеЕсли Вид = "shipments" Тогда Данные.Вставить("orderName", Строка(Объект.ЗаказКлиента)); КонецЕсли;
    Возврат Данные;
КонецФункции

Функция СписокОбъектов(Вид, Поиск = "")
    Список = Новый Массив; Выборка = Менеджер(Вид).Выбрать();
    Пока Выборка.Следующий() Цикл
        Объект = Выборка.Ссылка.ПолучитьОбъект();
        Текст = ?(ЭтоСправочник(Вид), Строка(Объект.Ссылка), Объект.Номер);
        Если ПустаяСтрока(Поиск) Или СтрНайти(НРег(Текст), НРег(Поиск)) > 0 Тогда Список.Добавить(ДанныеОбъекта(Объект, Вид)); КонецЕсли;
    КонецЦикла;
    Возврат Список;
КонецФункции

Процедура ЗаполнитьОбъект(Объект, Вид, Данные)
    Если ЭтоСправочник(Вид) Тогда
        Для Каждого П Из ПоляСправочника(Вид) Цикл Объект[П.Значение] = Поле(Данные, П.Ключ); КонецЦикла;
    Иначе
        Объект.Дата = МестноеВремя(ПрочитатьДатуJSON(Данные.date, ФорматДатыJSON.ISO), "Europe/Moscow");
        Объект.Комментарий = Поле(Данные, "comment");
        Если Вид = "orders" Тогда Объект.Клиент = Ссылка("clients", Поле(Данные, "clientId")); КонецЕсли;
        Если Вид = "shipments" Тогда Объект.ЗаказКлиента = Ссылка("orders", Поле(Данные, "orderId")); КонецЕсли;
        Объект.Товары.Очистить();
        Для Каждого С Из Данные.rows Цикл
            СтрокаТоваров = Объект.Товары.Добавить();
            СтрокаТоваров.Товар = Ссылка("products", Поле(С, "productId")); СтрокаТоваров.Склад = Ссылка("warehouses", Поле(С, "warehouseId"));
            СтрокаТоваров.Количество = XMLЗначение(Тип("Число"), С.quantity);
            Если Вид = "orders" Тогда СтрокаТоваров.Цена = XMLЗначение(Тип("Число"), Поле(С, "price", "0")); КонецЕсли;
        КонецЦикла;
    КонецЕсли;
КонецПроцедуры

Функция ИзменитьОбъект(Операция, Параметры)
    Вид = Параметры.entity; Идентификатор = Поле(Параметры, "id");
    Если ПустаяСтрока(Идентификатор) Тогда
        Если (Прав(Операция, 5) = ".save") Тогда
            Объект = ?(ЭтоСправочник(Вид), Менеджер(Вид).СоздатьЭлемент(), Менеджер(Вид).СоздатьДокумент());
        Иначе СкладскойУчет.Ошибка("VALIDATION", "Для операции нужна ссылка на объект."); КонецЕсли;
    Иначе
        Объект = Ссылка(Вид, Идентификатор).ПолучитьОбъект();
        Если ДанныеОбъекта(Объект, Вид).version <> Поле(Параметры, "version") Тогда СкладскойУчет.Ошибка("VERSION_CONFLICT", "Объект изменился. Перечитайте актуальную версию из 1С."); КонецЕсли;
    КонецЕсли;
    Если (Прав(Операция, 5) = ".save") Тогда
        ЗаполнитьОбъект(Объект, Вид, Параметры.data);
        Если ЭтоСправочник(Вид) Тогда Объект.Записать();
        Иначе Объект.Записать(?(Объект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись)); КонецЕсли;
    ИначеЕсли Операция = "document.post" Тогда Объект.Записать(РежимЗаписиДокумента.Проведение);
    ИначеЕсли Операция = "document.unpost" Тогда Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
    ИначеЕсли Операция = "object.markDeletion" Тогда Объект.УстановитьПометкуУдаления(Параметры.data.deleted);
    Иначе СкладскойУчет.Ошибка("VALIDATION", "Операция изменения не поддерживается."); КонецЕсли;
    Возврат Новый Структура("item", ДанныеОбъекта(Объект, Вид));
КонецФункции

Функция ОтчетОстатков(Параметры) Экспорт
    Строки = Новый Массив;
    Для Каждого С Из СкладскойУчет.Остатки() Цикл
        Если Поле(Параметры, "productId") <> "" И ИД(С.Товар) <> Параметры.productId Тогда Продолжить; КонецЕсли;
        Если Поле(Параметры, "warehouseId") <> "" И ИД(С.Склад) <> Параметры.warehouseId Тогда Продолжить; КонецЕсли;
        Строки.Добавить(Новый Структура("productId,productName,unit,warehouseId,warehouseName,physical,reserved,available", ИД(С.Товар), Строка(С.Товар), С.Товар.ЕдиницаИзмерения, ИД(С.Склад), Строка(С.Склад), Десятичное(С.Физический), Десятичное(С.Резерв), Десятичное(С.Физический - С.Резерв)));
    КонецЦикла;
    Возврат Новый Структура("rows", Строки);
КонецФункции

Функция ОтчетЗаказов(Параметры) Экспорт
    Строки = Новый Массив; Выборка = Документы.ЗаказКлиента.Выбрать();
    Пока Выборка.Следующий() Цикл
        Объект = Выборка.Ссылка.ПолучитьОбъект();
        Если Поле(Параметры, "orderId") <> "" И ИД(Объект.Ссылка) <> Параметры.orderId Тогда Продолжить; КонецЕсли;
        Если Поле(Параметры, "clientId") <> "" И ИД(Объект.Клиент) <> Параметры.clientId Тогда Продолжить; КонецЕсли;
        Выполнение = Исполнение(Объект);
        Для Каждого С Из Выполнение.rows Цикл
            С.Вставить("orderId", ИД(Объект.Ссылка)); С.Вставить("orderName", Строка(Объект.Ссылка));
            С.Вставить("clientId", ИД(Объект.Клиент)); С.Вставить("clientName", Строка(Объект.Клиент)); С.Вставить("state", Выполнение.state);
            Строки.Добавить(С);
        КонецЦикла;
    КонецЦикла;
    Возврат Новый Структура("rows", Строки);
КонецФункции

Функция ВыполнитьКоманду(Команда) Экспорт
    Операция = Команда.operation; П = Команда.payload;
    Если Операция = "system.info" Тогда
        Информация = Новый СистемнаяИнформация; Возврат Новый Структура("platform", Информация.ВерсияПриложения);
    ИначеЕсли Операция = "catalog.list" Или Операция = "document.list" Тогда Возврат Новый Структура("items", СписокОбъектов(П.entity, Поле(П, "search")));
    ИначеЕсли Операция = "catalog.get" Или Операция = "document.get" Тогда Возврат Новый Структура("item", ДанныеОбъекта(Ссылка(П.entity, П.id).ПолучитьОбъект(), П.entity));
    ИначеЕсли Операция = "report.stock" Тогда Возврат ОтчетОстатков(П);
    ИначеЕсли Операция = "report.orders" Тогда Возврат ОтчетЗаказов(П);
    ИначеЕсли Операция = "order.remaining" Тогда
        Объект = Ссылка("orders", П.id).ПолучитьОбъект();
        Если Не Объект.Проведен Тогда СкладскойУчет.Ошибка("VALIDATION", "Для подбора нужен проведённый заказ.", "orderId"); КонецЕсли;
        Строки = Новый Массив;
        Для Каждого С Из Исполнение(Объект).rows Цикл Если XMLЗначение(Тип("Число"), С.remaining) > 0 Тогда Строки.Добавить(С); КонецЕсли; КонецЦикла;
        Возврат Новый Структура("rows", Строки);
    ИначеЕсли Операция = "catalog.save" Или Операция = "document.save" Или Операция = "document.post" Или Операция = "document.unpost" Или Операция = "object.markDeletion" Тогда
        Возврат ИзменитьОбъект(Операция, П);
    КонецЕсли;
    СкладскойУчет.Ошибка("VALIDATION", "Команда отсутствует в списке разрешённых операций.");
КонецФункции

Функция РазобратьОшибку(Информация)
    Пока Информация.Причина <> Неопределено Цикл Информация = Информация.Причина; КонецЦикла;
    Текст = Информация.Описание; Позиция = СтрНайти(Текст, "WH:");
    Если Позиция > 0 Тогда
        Попытка Возврат ИзJSON(Сред(Текст, Позиция + 3)); Исключение КонецПопытки;
    КонецЕсли;
    Возврат Новый Структура("code,message", "ONEC_ERROR", Лев(Текст, 4000));
КонецФункции

Функция ОбработатьЗадание(ТекстЗадания) Экспорт
    Задание = ИзJSON(ТекстЗадания); Команда = Задание.command;
    Ответ = Новый Структура("id,attempt,status", Задание.id, Задание.attempt, "failed");
    Изменение = (Прав(Команда.operation, 5) = ".save") Или Команда.operation = "document.post" Или Команда.operation = "document.unpost" Или Команда.operation = "object.markDeletion";
    Попытка
        Если Изменение Тогда
            НачатьТранзакцию();
            Блокировка = Новый БлокировкаДанных;
            Элемент = Блокировка.Добавить("РегистрСведений.ВыполненныеКомандыВеб");
            Элемент.УстановитьЗначение("ИдентификаторКоманды", Команда.id); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
            Запись = РегистрыСведений.ВыполненныеКомандыВеб.СоздатьМенеджерЗаписи();
            Запись.ИдентификаторКоманды = Команда.id; Запись.Прочитать();
            Если Запись.Выбран() Тогда
                Если Запись.Отпечаток <> Задание.fingerprint Тогда СкладскойУчет.Ошибка("UUID_CONFLICT", "UUID уже использован с другим содержимым."); КонецЕсли;
                Результат = ИзJSON(Запись.Результат);
            Иначе
                Результат = ВыполнитьКоманду(Команда);
                // Прочитать() очищает поля менеджера, если запись ещё отсутствует.
                Запись.ИдентификаторКоманды = Команда.id;
                Запись.Отпечаток = Задание.fingerprint; Запись.Результат = СкладскойУчет.JSONСтрока(Результат); Запись.Записать();
            КонецЕсли;
            ЗафиксироватьТранзакцию();
        Иначе Результат = ВыполнитьКоманду(Команда); КонецЕсли;
        Ответ.status = "succeeded"; Ответ.Вставить("result", Результат);
    Исключение
        Информация = ИнформацияОбОшибке();
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        Ответ.Вставить("error", РазобратьОшибку(Информация));
    КонецПопытки;
    Возврат СкладскойУчет.JSONСтрока(Ответ);
КонецФункции

Процедура ВывестиОтчет(Вид, ДокументРезультат) Экспорт
    Данные = ?(Вид = "stock", ОтчетОстатков(Новый Структура), ОтчетЗаказов(Новый Структура));
    Поля = ?(Вид = "stock", "productName,unit,warehouseName,physical,reserved,available", "orderName,clientName,productName,warehouseName,ordered,shipped,remaining,state");
    Заголовки = ?(Вид = "stock", "Товар,Единица,Склад,Физический остаток,Резерв,Доступно", "Заказ,Клиент,Товар,Склад,Заказано,Отгружено,Осталось,Состояние");
    Имена = СтрРазделить(Поля, ","); Подписи = СтрРазделить(Заголовки, ","); Номер = 1;
    ДокументРезультат.Очистить();
    Для Колонка = 0 По Имена.Количество() - 1 Цикл ДокументРезультат.Область(1, Колонка + 1).Текст = Подписи[Колонка]; КонецЦикла;
    Для Каждого С Из Данные.rows Цикл
        Номер = Номер + 1;
        Для Колонка = 0 По Имена.Количество() - 1 Цикл ДокументРезультат.Область(Номер, Колонка + 1).Текст = С[Имена[Колонка]]; КонецЦикла;
    КонецЦикла;
КонецПроцедуры

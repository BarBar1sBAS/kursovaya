Функция JSONСтрока(Значение) Экспорт
    Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение); Возврат Запись.Закрыть();
КонецФункции

Процедура Ошибка(Код, Текст, Поле = "", НомерСтроки = -1, Запрошено = Неопределено, Доступно = Неопределено) Экспорт
    Данные = Новый Структура("code,message", Код, Текст);
    Если Поле <> "" Тогда Данные.Вставить("field", Поле); КонецЕсли;
    Если НомерСтроки >= 0 Тогда Данные.Вставить("row", НомерСтроки); КонецЕсли;
    Если Запрошено <> Неопределено Тогда Данные.Вставить("requested", Формат(Запрошено, "ЧГ=0;ЧДЦ=3;ЧРД=.")); КонецЕсли;
    Если Доступно <> Неопределено Тогда Данные.Вставить("available", Формат(Доступно, "ЧГ=0;ЧДЦ=3;ЧРД=.")); КонецЕсли;
    ВызватьИсключение "WH:" + JSONСтрока(Данные);
КонецПроцедуры

Функция ЗапросТаблица(Текст, Параметры = Неопределено) Экспорт
    Запрос = Новый Запрос(Текст);
    Если Параметры <> Неопределено Тогда
        Для Каждого П Из Параметры Цикл Запрос.УстановитьПараметр(П.Ключ, П.Значение); КонецЦикла;
    КонецЕсли;
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция Остатки() Экспорт
    Возврат ЗапросТаблица("ВЫБРАТЬ Д.Товар КАК Товар, Д.Склад КАК Склад,
    | СУММА(Д.Физический) КАК Физический, СУММА(Д.Резерв) КАК Резерв
    | ИЗ (ВЫБРАТЬ Товар, Склад, КоличествоОстаток КАК Физический, 0 КАК Резерв
    | ИЗ РегистрНакопления.ОстаткиТоваров.Остатки()
    | ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Товар, Склад, 0, КоличествоОстаток
    | ИЗ РегистрНакопления.РезервыТоваров.Остатки()) КАК Д
    | СГРУППИРОВАТЬ ПО Д.Товар, Д.Склад");
КонецФункции

Функция ЕстьОтгрузки(Заказ, ТолькоПроведенные = Истина) Экспорт
    Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ОтгрузкаТоваров ГДЕ ЗаказКлиента = &Заказ";
    Если ТолькоПроведенные Тогда Текст = Текст + " И Проведен"; КонецЕсли;
    Возврат ЗапросТаблица(Текст, Новый Структура("Заказ", Заказ)).Количество() > 0;
КонецФункции

Функция КлючПары(СтрокаТоваров)
    Возврат Строка(СтрокаТоваров.Товар.УникальныйИдентификатор()) + "/" + Строка(СтрокаТоваров.Склад.УникальныйИдентификатор());
КонецФункции

Функция Состав(Объект)
    Таблица = Объект.Товары.Выгрузить(); Таблица.Сортировать("Товар, Склад");
    Итог = "";
    Для Каждого С Из Таблица Цикл
        Итог = Итог + КлючПары(С) + ":" + XMLСтрока(С.Количество);
        Если Объект.Метаданные().Имя = "ЗаказКлиента" Тогда Итог = Итог + ":" + XMLСтрока(С.Цена); КонецЕсли;
        Итог = Итог + ";";
    КонецЦикла;
    Возврат Итог;
КонецФункции

Процедура ПроверитьСправочник(Объект) Экспорт
    Если ПустаяСтрока(СокрЛП(Объект.Наименование)) Тогда Ошибка("VALIDATION", "Укажите наименование.", "name"); КонецЕсли;
    Если Объект.Метаданные().Имя = "Товары" И Не Объект.ЭтоНовый() Тогда
        Старый = Объект.Ссылка.ПолучитьОбъект();
        Если Старый.ЕдиницаИзмерения <> Объект.ЕдиницаИзмерения Тогда
            ЕстьДвижения = ЗапросТаблица("ВЫБРАТЬ ПЕРВЫЕ 1 Товар ИЗ РегистрНакопления.ОстаткиТоваров ГДЕ Товар = &Товар
            | ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ ПЕРВЫЕ 1 Товар ИЗ РегистрНакопления.РезервыТоваров ГДЕ Товар = &Товар", Новый Структура("Товар", Объект.Ссылка));
            Если ЕстьДвижения.Количество() > 0 Тогда Ошибка("DEPENDENCY_EXISTS", "У товара есть движения. Изменение единицы измерения запрещено.", "unit"); КонецЕсли;
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьДокумент(Объект, РежимЗаписи) Экспорт
    Имя = Объект.Метаданные().Имя;
    Пары = Новый Соответствие;
    Для Каждого С Из Объект.Товары Цикл
        Если С.Количество < 0 Тогда Ошибка("VALIDATION", "Количество не может быть отрицательным.", "quantity", С.НомерСтроки - 1); КонецЕсли;
        Если Имя = "ЗаказКлиента" Тогда
            Если С.Цена < 0 Тогда Ошибка("VALIDATION", "Цена не может быть отрицательной.", "price", С.НомерСтроки - 1); КонецЕсли;
            С.Сумма = Окр(С.Количество * С.Цена, 2);
            Если ЗначениеЗаполнено(С.Товар) И ЗначениеЗаполнено(С.Склад) Тогда
                Ключ = КлючПары(С);
                Если Пары.Получить(Ключ) <> Неопределено Тогда Ошибка("VALIDATION", "Пара товар и склад уже есть в заказе.", "warehouseId", С.НомерСтроки - 1); КонецЕсли;
                Пары.Вставить(Ключ, Истина);
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если Не Объект.ЭтоНовый() Тогда
        Старый = Объект.Ссылка.ПолучитьОбъект();
        Изменен = Старый.Дата <> Объект.Дата Или Состав(Старый) <> Состав(Объект);
        Если Имя = "ЗаказКлиента" Тогда
            Изменен = Изменен Или Старый.Клиент <> Объект.Клиент;
            Если Изменен И ЕстьОтгрузки(Объект.Ссылка) Тогда Ошибка("DEPENDENCY_EXISTS", "Сначала отмените проведение всех отгрузок заказа."); КонецЕсли;
        ИначеЕсли Имя = "ОтгрузкаТоваров" Тогда
            Если Старый.Проведен И Старый.ЗаказКлиента <> Объект.ЗаказКлиента Тогда Ошибка("DEPENDENCY_EXISTS", "Для смены заказа сначала отмените проведение отгрузки.", "orderId"); КонецЕсли;
        КонецЕсли;
        Если Изменен И Старый.Проведен И РежимЗаписи = РежимЗаписиДокумента.Запись Тогда Ошибка("VALIDATION", "Изменение проведённого документа требует перепроведения."); КонецЕсли;
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОбязательные(Объект)
    Имя = Объект.Метаданные().Имя;
    Если Объект.ПометкаУдаления Тогда Ошибка("VALIDATION", "Снимите пометку удаления перед проведением."); КонецЕсли;
    Если Объект.Товары.Количество() = 0 Тогда Ошибка("VALIDATION", "Добавьте хотя бы одну строку товаров.", "rows"); КонецЕсли;
    Если Имя = "ЗаказКлиента" И Не ЗначениеЗаполнено(Объект.Клиент) Тогда Ошибка("VALIDATION", "Укажите клиента.", "clientId"); КонецЕсли;
    Если Имя = "ОтгрузкаТоваров" Тогда
        Если Не ЗначениеЗаполнено(Объект.ЗаказКлиента) Тогда Ошибка("VALIDATION", "Укажите заказ клиента.", "orderId"); КонецЕсли;
        Если Не Объект.ЗаказКлиента.Проведен Тогда Ошибка("VALIDATION", "Заказ должен быть проведён.", "orderId"); КонецЕсли;
    КонецЕсли;
    Для Каждого С Из Объект.Товары Цикл
        Если Не ЗначениеЗаполнено(С.Товар) Тогда Ошибка("VALIDATION", "Укажите товар.", "productId", С.НомерСтроки - 1); КонецЕсли;
        Если Не ЗначениеЗаполнено(С.Склад) Тогда Ошибка("VALIDATION", "Укажите склад.", "warehouseId", С.НомерСтроки - 1); КонецЕсли;
        Если С.Товар.ПометкаУдаления Или С.Склад.ПометкаУдаления Тогда Ошибка("VALIDATION", "Товар или склад помечен на удаление.", "productId", С.НомерСтроки - 1); КонецЕсли;
        Если ПустаяСтрока(С.Товар.ЕдиницаИзмерения) Тогда Ошибка("VALIDATION", "Укажите базовую единицу товара.", "productId", С.НомерСтроки - 1); КонецЕсли;
        Если С.Количество <= 0 Тогда Ошибка("VALIDATION", "Количество должно быть положительным.", "quantity", С.НомерСтроки - 1); КонецЕсли;
        Если Имя = "ОтгрузкаТоваров" Тогда
            Позиция = Объект.ЗаказКлиента.Товары.НайтиСтроки(Новый Структура("Товар,Склад", С.Товар, С.Склад));
            Если Позиция.Количество() = 0 Тогда Ошибка("VALIDATION", "Товар и склад отсутствуют в исходном заказе.", "productId", С.НомерСтроки - 1); КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьДвижение(Набор, Объект, С, Вид, СЗаказом)
    Движение = Набор.Добавить(); Движение.Период = Объект.Дата;
    Движение.ВидДвижения = Вид; Движение.Товар = С.Товар; Движение.Склад = С.Склад; Движение.Количество = С.Количество;
    Если СЗаказом Тогда
        Движение.ЗаказКлиента = ?(Объект.Метаданные().Имя = "ЗаказКлиента", Объект.Ссылка, Объект.ЗаказКлиента);
    КонецЕсли;
КонецПроцедуры

Процедура ПодготовитьНаборы(Объект, Удаление = Ложь)
    Имя = Объект.Метаданные().Имя;
    Если Имя <> "ЗаказКлиента" Тогда Объект.Движения.ОстаткиТоваров.Записывать = Истина; Объект.Движения.ОстаткиТоваров.Очистить(); КонецЕсли;
    Если Имя <> "ПоступлениеТоваров" Тогда Объект.Движения.РезервыТоваров.Записывать = Истина; Объект.Движения.РезервыТоваров.Очистить(); КонецЕсли;
    Если Не Удаление Тогда
        Для Каждого С Из Объект.Товары Цикл
            Если Имя = "ПоступлениеТоваров" Тогда
                ЗаполнитьДвижение(Объект.Движения.ОстаткиТоваров, Объект, С, ВидДвиженияНакопления.Приход, Ложь);
            ИначеЕсли Имя = "ЗаказКлиента" Тогда
                ЗаполнитьДвижение(Объект.Движения.РезервыТоваров, Объект, С, ВидДвиженияНакопления.Приход, Истина);
            Иначе
                ЗаполнитьДвижение(Объект.Движения.ОстаткиТоваров, Объект, С, ВидДвиженияНакопления.Расход, Ложь);
                ЗаполнитьДвижение(Объект.Движения.РезервыТоваров, Объект, С, ВидДвиженияНакопления.Расход, Истина);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Объект.Движения.Записать();
КонецПроцедуры

Процедура ОшибкаНедостатка(Объект, Товар, Склад, Осталось, Текст)
    Количество = 0; Индекс = -1;
    Для Каждого С Из Объект.Товары Цикл
        Если С.Товар = Товар И С.Склад = Склад Тогда Количество = Количество + С.Количество; Если Индекс < 0 Тогда Индекс = С.НомерСтроки - 1; КонецЕсли; КонецЕсли;
    КонецЦикла;
    Допустимо = Количество + Осталось;
    Ошибка("INSUFFICIENT_STOCK", Текст + ": " + Строка(Товар) + ", " + Строка(Склад) + ". Запрошено " + Строка(Количество) + ", допустимо " + Строка(Допустимо) + ".", "quantity", Индекс, Количество, Допустимо);
КонецПроцедуры

Процедура ПроверитьИнварианты(Объект)
    // ponytail: проверяем все текущие пары учебной базы; для больших объёмов ограничить объединением старых и новых пар.
    Отрицательные = ЗапросТаблица("ВЫБРАТЬ ЗаказКлиента, Товар, Склад, КоличествоОстаток КАК Осталось
    | ИЗ РегистрНакопления.РезервыТоваров.Остатки() ГДЕ КоличествоОстаток < 0");
    Если Отрицательные.Количество() > 0 Тогда
        С = Отрицательные[0]; ОшибкаНедостатка(Объект, С.Товар, С.Склад, С.Осталось, "Превышен резерв заказа");
    КонецЕсли;
    Для Каждого С Из Остатки() Цикл
        Если С.Физический < 0 Или С.Физический - С.Резерв < 0 Тогда
            Если Объект.Метаданные().Имя = "ЗаказКлиента" Тогда
                ОшибкаНедостатка(Объект, С.Товар, С.Склад, С.Физический - С.Резерв, "Недостаточно доступного товара");
            Иначе
                Ошибка("DEPENDENCY_EXISTS", "Операция оставляет недостаточный физический запас или запас ниже действующего резерва: " + Строка(С.Товар) + ", " + Строка(С.Склад) + ".");
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура Провести(Объект) Экспорт
    ПроверитьОбязательные(Объект);
    ПодготовитьНаборы(Объект);
    ПроверитьИнварианты(Объект);
КонецПроцедуры

Процедура ОтменитьПроведение(Объект) Экспорт
    Если Объект.Метаданные().Имя = "ЗаказКлиента" И ЕстьОтгрузки(Объект.Ссылка) Тогда Ошибка("DEPENDENCY_EXISTS", "Сначала отмените проведение всех отгрузок заказа."); КонецЕсли;
    ПодготовитьНаборы(Объект, Истина);
    ПроверитьИнварианты(Объект);
КонецПроцедуры

Процедура ПроверитьУдалениеДокумента(Объект) Экспорт
    Если Объект.Проведен Тогда Ошибка("DEPENDENCY_EXISTS", "Перед удалением отмените проведение документа."); КонецЕсли;
    Если Объект.Метаданные().Имя = "ЗаказКлиента" И ЕстьОтгрузки(Объект.Ссылка, Ложь) Тогда Ошибка("DEPENDENCY_EXISTS", "На заказ ссылаются отгрузки. Удаление запрещено."); КонецЕсли;
КонецПроцедуры

Процедура ПроверитьУдалениеСправочника(Объект) Экспорт
    Ссылки = Новый Массив; Ссылки.Добавить(Объект.Ссылка);
    Если НайтиПоСсылкам(Ссылки).Количество() > 0 Тогда Ошибка("DEPENDENCY_EXISTS", "Объект используется в документах. Физическое удаление запрещено."); КонецЕсли;
КонецПроцедуры

Процедура ПриНачалеРаботыСистемы()
    Части = СтрРазделить(ПараметрЗапуска, "|");
    Если Части.Количество() >= 2 И Части[0] = "selftest" Тогда
        ПроверкиСклада.ЗапуститьПроверки(Части[1]);
        ЗавершитьРаботуСистемы(Ложь);
    ИначеЕсли Части.Количество() >= 2 И Части[0] = "api-selftest" Тогда
        ПроверкиСклада.ПроверитьПовторAPI(Части[1]);
        ЗавершитьРаботуСистемы(Ложь);
    ИначеЕсли Части.Количество() >= 2 И Части[0] = "demo" Тогда
        ПроверкиСклада.ПодготовитьДемонстрацию(Части[1]);
        ЗавершитьРаботуСистемы(Ложь);
    Иначе
        ОткрытьФорму("ОбщаяФорма.ВебОбмен");
    КонецЕсли;
КонецПроцедуры

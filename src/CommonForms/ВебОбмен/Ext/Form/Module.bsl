&НаКлиенте
Перем СеансОбмена;
&НаКлиенте
Перем ВОбмене;
&НаКлиенте
Перем ОбменВключен;
&НаКлиенте
Перем НеотправленныйОтвет;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    Порт = 4318;
    Состояние = "Обмен выключен.";
    СеансОбмена = Строка(Новый УникальныйИдентификатор);
    ВОбмене = Ложь;
    ОбменВключен = Ложь;
    Части = СтрРазделить(ПараметрЗапуска, "|");
    Если Части.Количество() >= 2 И Части[0] = "bridge" Тогда
        Попытка
            ЧтениеСекрета = Новый ЧтениеТекста(Части[1], КодировкаТекста.UTF8);
            Секрет = СокрЛП(ЧтениеСекрета.Прочитать()); ЧтениеСекрета.Закрыть();
            Если Части.Количество() >= 3 Тогда Порт = Число(Части[2]); КонецЕсли;
            ВключитьОбмен(Неопределено);
        Исключение Состояние = "Не удалось прочитать файл секрета: " + ОписаниеОшибки(); КонецПопытки;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВключитьОбмен(Команда)
    Если ОбменВключен Тогда Возврат; КонецЕсли;
    Если СтрДлина(Секрет) <> 64 Тогда
        Состояние = "Укажите секрет из runtime/bridge/token.";
        Возврат;
    КонецЕсли;
    ОбменВключен = Истина;
    ПодключитьОбработчикОжидания("ТактОбмена", 1);
    Состояние = "Обмен включён.";
КонецПроцедуры

&НаКлиенте
Процедура ТактОбмена() Экспорт
    Если ВОбмене Или Не ОбменВключен Тогда Возврат; КонецЕсли;
    ВОбмене = Истина;
    Попытка
        Если НеотправленныйОтвет <> Неопределено Тогда
            ОтправитьHTTP("/bridge/v1/result", Новый Структура("worker,response", СеансОбмена, НеотправленныйОтвет), Истина);
            НеотправленныйОтвет = Неопределено;
        КонецЕсли;
        Задание = ОтправитьHTTP("/bridge/v1/pull", Новый Структура("worker", СеансОбмена));
        Если Задание <> Неопределено И Задание <> Null Тогда
            ЗаписьЗадания = Новый ЗаписьJSON; ЗаписьЗадания.УстановитьСтроку(); ЗаписатьJSON(ЗаписьЗадания, Задание);
            ЧтениеОтвета = Новый ЧтениеJSON; ЧтениеОтвета.УстановитьСтроку(ОтветНаКоманду(ЗаписьЗадания.Закрыть()));
            Ответ = ПрочитатьJSON(ЧтениеОтвета); ЧтениеОтвета.Закрыть();
            // Не выполнять новое задание, пока результат текущего не принят посредником.
            НеотправленныйОтвет = Ответ;
            ОтправитьHTTP("/bridge/v1/result", Новый Структура("worker,response", СеансОбмена, НеотправленныйОтвет), Истина);
            НеотправленныйОтвет = Неопределено;
        КонецЕсли;
        Состояние = "Посредник доступен. Команды выполняются в этой базе 1С.";
    Исключение
        Состояние = "Обмен приостановлен до следующей попытки: " + ОписаниеОшибки();
    КонецПопытки;
    ВОбмене = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ВыключитьОбмен(Команда)
    Если ВОбмене Тогда Возврат; КонецЕсли;
    Попытка
        Если НеотправленныйОтвет <> Неопределено Тогда
            ОтправитьHTTP("/bridge/v1/result", Новый Структура("worker,response", СеансОбмена, НеотправленныйОтвет), Истина);
            НеотправленныйОтвет = Неопределено;
        КонецЕсли;
        Если ОбменВключен Тогда
            ОтправитьHTTP("/bridge/v1/release", Новый Структура("worker", СеансОбмена));
            ОтключитьОбработчикОжидания("ТактОбмена");
        КонецЕсли;
        ОбменВключен = Ложь;
        Состояние = "Обмен выключен.";
    Исключение
        Состояние = "Не удалось закрыть обмен: " + ОписаниеОшибки();
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ОтправитьHTTP(Путь, Данные, ПовторРезультата = Ложь)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Заголовки.Вставить("Authorization", "Bearer " + Секрет);
    Запрос = Новый HTTPЗапрос(Путь, Заголовки);
    Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
    Соединение = Новый HTTPСоединение("127.0.0.1", Порт, , , , 3);
    Ответ = Соединение.ОтправитьДляОбработки(Запрос);
    // После перезапуска посредника выдача меняется. Получаем команду снова; UUID защищён журналом 1С.
    Если ПовторРезультата И Ответ.КодСостояния = 409 Тогда Возврат Неопределено; КонецЕсли;
    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "Посредник вернул код " + Строка(Ответ.КодСостояния) + ": " + Ответ.ПолучитьТелоКакСтроку();
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
    Результат = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ОтветНаКоманду(Текст)
    Возврат ВебСервисСклад.ОбработатьЗадание(Текст);
КонецФункции

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
    ВыключитьОбмен(Неопределено);
    Если ОбменВключен Тогда Отказ = Истина; Сообщить(Состояние); КонецЕсли;
КонецПроцедуры
